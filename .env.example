# =============================================================
# Data Lineage Discovery Dashboard — environment configuration
# Copy this file to .env and fill in the values for your setup.
# =============================================================

# -------------------------------------------------------------
# OPTION A — Production: GCP Secret Manager (recommended)
#
# The app authenticates to Secret Manager via Application
# Default Credentials (ADC).  On a GCP VM this means the VM's
# attached service account — no credential file required.
#
# Steps:
#   1. Create the secret in your GCP project:
#        gcloud secrets create anthropic-api-key \
#          --replication-policy="automatic"
#        echo -n "sk-ant-..." | \
#          gcloud secrets versions add anthropic-api-key --data-file=-
#
#   2. Grant your service account access:
#        gcloud secrets add-iam-policy-binding anthropic-api-key \
#          --member="serviceAccount:YOUR_SA@PROJECT.iam.gserviceaccount.com" \
#          --role="roles/secretmanager.secretAccessor"
#
#   3. Set these variables (leave ANTHROPIC_API_KEY empty):
# -------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_SECRET_NAME=anthropic-api-key
GCP_SECRET_VERSION=latest

# -------------------------------------------------------------
# OPTION B — Local development: direct API key in env
#
# Only for local dev. Leave GCP_PROJECT_ID empty so the app
# skips Secret Manager and uses this value directly.
# NEVER commit the actual key — this file is .gitignored.
# -------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------
# App settings (same for both options)
# -------------------------------------------------------------
ETL_REPO_PATH=./data/sample_etl
CHROMA_PERSIST_DIR=./chroma_db
ALIAS_REGISTRY_PATH=./data/alias_registry.json
LLM_MODEL=claude-opus-4-7
EMBEDDING_MODEL=all-MiniLM-L6-v2
